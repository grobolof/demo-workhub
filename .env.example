# Хост приложения:
APP_HOST=workhub.docker.local

# Путь внутри контейнера, куда docker-compose монтирует корень репозитория (./:${APP_PATH})
APP_PATH=/pub/www/app

# Доступы для СУБД:
DB_HOST=database
DB_DATABASE=sitemanager
DB_USER=login
DB_PASSWORD=pass
DB_ROOT_PASSWORD=secret

# Если установить значение 1, то файл cron_events.php будет выполняться раз в минуту
# Если установить значени 0, то файл cron_events.php не будет выполняться
BITRIX_CRON_ENABLED=0

# Elasticsearch внутри docker-сети (образ elasticsearch с Docker Hub)
ELASTICSEARCH_URL=http://elasticsearch:9200
